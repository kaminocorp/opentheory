APP_ENV=local
APP_NAME=OpenTheory API
API_V1_PREFIX=/api/v1

# App connection. Locally this is a plain local Postgres. In production, point it at the
# Supabase TRANSACTION POOLER (port 6543) with the asyncpg driver and ssl=require, e.g.:
#   postgresql+asyncpg://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opentheory

# Optional separate connection used ONLY by Alembic migrations — DDL + schema introspection
# prefer a stable, non-pooled session. In production this is the Supabase DIRECT connection
# (port 5432). Falls back to DATABASE_URL when unset.
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres?ssl=require

# Comma-separated allowed browser origins (no trailing slash). In production this is your
# deployed frontend URL, e.g. https://opentheory.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Auth (0.6.0; ES256/JWKS since 0.7.x) -----------------------------------------------
# The backend only verifies the Supabase-issued session JWT and reads its claims (Decision #2).
# Supabase signs sessions with ES256 (asymmetric) and publishes the public keys at the project's
# JWKS endpoint; the backend fetches the signing key by `kid` from there — no shared secret.
# Set SUPABASE_PROJECT_URL (public; same value as the frontend's NEXT_PUBLIC_SUPABASE_URL); the
# JWKS URL is derived as <url>/auth/v1/.well-known/jwks.json.
SUPABASE_PROJECT_URL=https://<ref>.supabase.co
# Override the derived JWKS endpoint directly (optional; takes precedence over PROJECT_URL).
# SUPABASE_JWKS_URL=
# Expected `aud` claim. Supabase signs signed-in users with aud="authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# When true, a local/test actor header path stays active so writes work without an IdP.
# MUST be false in production — then only a verified bearer token is accepted.
AUTH_DEV_HEADER_ENABLED=true

# Comma-separated emails granted the `internal` role on first sign-in (JIT). The
# internal role gates native funding. Compared case-insensitively. e.g. you@example.com
INTERNAL_ACTOR_EMAILS=

# --- Toolbench execution sandbox (0.11.x) -----------------------------------------------
# Wall-clock cap (seconds) for instrument runs. Sync SymPy runs use a killable subprocess in prod.
TOOLBENCH_WALL_TIMEOUT_S=30
# Child memory ceiling (MB) via RLIMIT_AS on Linux. 0 = disabled (default locally; macOS dev).
# Production Fly: TOOLBENCH_MEMORY_LIMIT_MB=256
TOOLBENCH_MEMORY_LIMIT_MB=0
# Max concurrent instrument runs per API process.
TOOLBENCH_MAX_CONCURRENT_RUNS=2
# How long a run waits for a concurrency slot before 503.
TOOLBENCH_ACQUIRE_TIMEOUT_S=5
# Set false only in fast unit tests; production must keep true.
TOOLBENCH_SUBPROCESS_SANDBOX_ENABLED=true
# Soft timeout (ms) for Z3's internal solver clock. Keep below TOOLBENCH_WALL_TIMEOUT_S * 1000 so a
# hard problem returns unknown→undecided (recorded) instead of a subprocess kill (mints nothing).
TOOLBENCH_Z3_TIMEOUT_MS=10000
# Soft timeout (ms) for interval.eval. Keep below TOOLBENCH_WALL_TIMEOUT_S * 1000 so a
# slow enclosure returns undecided (recorded) instead of a subprocess kill (mints nothing).
# python-flint is a locked wheel (~10 MiB). If the extension fails to import, the
# instrument degrades to mpmath.iv, then to undecided — never a fabricated bound.
TOOLBENCH_INTERVAL_TIMEOUT_MS=8000
# Soft timeout (ms) for lean.prove. Keep below TOOLBENCH_WALL_TIMEOUT_S * 1000 so a
# slow typecheck returns undecided (recorded) instead of a subprocess kill (mints nothing).
# Lean is optional — if `lean` is not on PATH the instrument returns undecided/unavailable
# and every other instrument keeps working. Do not install Lean in CI just to go green.
TOOLBENCH_LEAN_TIMEOUT_MS=8000
# Soft timeout (ms) for lean.prove mathlib=true. Keep below the wall. Do not install
# Mathlib / lake in CI — missing Mathlib is undecided/mathlib_unavailable.
TOOLBENCH_LEAN_MATHLIB_TIMEOUT_MS=20000
# Optional path to a pre-built Mathlib lake project. Empty uses /opt/opentheory/lean-mathlib
# when that directory exists. Never required to boot the API.
# TOOLBENCH_MATHLIB_LAKE=/opt/opentheory/lean-mathlib
# Contact address put in the outbound User-Agent (Crossref polite pool; courtesy on arXiv /
# OpenAlex). Not a secret. Leave blank locally.
# TOOLBENCH_RETRIEVAL_MAILTO=ops@example.com
# Optional OpenAlex API key. Unauthenticated calls still work for demos (tiny daily budget);
# production agent loops should set this. As of Feb 2026 the polite-pool mailto is ignored —
# a key is the real quota. Never required to start the API; a missing key is not a 500.
# OPENALEX_API_KEY=

# --- Thin agent loop (0.12.x) -----------------------------------------------------------
# The agent loop plans a short sequence of existing instrument runs via OpenRouter and lands them
# on an agent branch through the same chokepoint humans use. OPENROUTER_API_KEY is a Fly SECRET in
# production (`fly secrets set OPENROUTER_API_KEY=...`), never fly.toml [env]. Leave blank locally
# until you are actually driving a pass; a missing key surfaces as a clean 422/503, never a 500.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Wall-clock cap (seconds) for one planning / replan call.
AGENT_LLM_TIMEOUT_S=60
# Per-pass SAFETY caps (blast radius). The project ceiling is AGENT_TOKEN_RATE_USD_PER_1K
# × recorded tokens, debited in 0.19.0 (historically sketched as 0.12.5).
AGENT_PASS_MAX_RUNS=5
# Additional planning calls after the initial plan (0 = one-shot). Default 2.
AGENT_PASS_MAX_REPLANS=2
# Max runnable steps one plan version may propose (keeps a batch short so observe can replan).
AGENT_PASS_MAX_BATCH_RUNS=2
AGENT_PASS_MAX_TOKENS=200000
# Default blended USD per 1 000 planning tokens. Snapshot onto each ComputeDebit
# when live OpenRouter prices are unavailable (0.28.0 fallback).
AGENT_TOKEN_RATE_USD_PER_1K=0.005
# Live OpenRouter model prices (0.28.0). Off = always use the blended rate above
# (still meters; never skips). Cache is process-local; a refresh is one short
# GET /models. Keep the timeout tiny so a slow catalog cannot stall a pass.
OPENROUTER_LIVE_PRICES=true
OPENROUTER_PRICE_CACHE_TTL_S=3600
OPENROUTER_PRICE_TIMEOUT_S=2
# Dark-launch flag. Keep false until the loop is ready. Production enablement is this flag
# plus OPENROUTER_API_KEY (a Fly secret) — see docs/operations/deploy.md. Do not invent a
# second key or a second flag. Per-pass SAFETY caps above still bound blast radius; the
# project ceiling is 0.19.0 metering.
AGENT_LOOP_ENABLED=false
# Hard cap on how many thread passes one "Run research" orchestration may commission.
# Per-pass safety caps and the project ceiling still bind each sub-pass.
ORCHESTRATION_MAX_PASSES=4
# How many of those sub-passes may run at once (0.27.0). Default 2; 1 is sequential.
# Clamped to 8. Each concurrent pass reserves a slice of available before it starts.
ORCHESTRATION_CONCURRENCY=2
# Continuous campaign (0.25.0 / 0.32.0): how many 0.22.0 orchestrations one
# Start may commission, how many of those may run at once (1 = sequential),
# and how many consecutive failed cycles stop the loop. Safety caps, not a
# second dark-launch flag — same AGENT_LOOP_ENABLED gate.
CAMPAIGN_MAX_CYCLES=8
CAMPAIGN_CYCLE_CONCURRENCY=1
CAMPAIGN_ERROR_BUDGET=3
